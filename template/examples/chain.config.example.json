{
  "_comment": "Example of a flat (legacy) config for a chain of unattended runs. Prefer a task workspace: viewer.py init-task + configure. Paths are relative to 'repo'.",
  "title": "Nightly build monitor",
  "port": 8765,
  "repo": "../../../../..",
  "transcripts_dir": "auto",
  "window_hours": 8,
  "active_seconds": 120,
  "include_unmatched": false,
  "session_rules": [
    {
      "match": "run-build[.]md.*?STEP=([A-Z0-9]+)",
      "label": "build step {1}"
    }
  ],
  "panels": {
    "machine": true,
    "git": true,
    "logs": true,
    "ledger": true,
    "chain_log": true,
    "attempts": true
  },
  "live_log_globs": [
    "logs/*.log"
  ],
  "chain_log": "logs/chain.log",
  "ledger": "docs/status.md",
  "stop_file": "STOP",
  "attempts": {
    "label_prefix": "build step ",
    "time_format": "%Y-%m-%d %H:%M:%S",
    "start": "^(?P<time>[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:]{8}) STEP (?P<part>[A-Z0-9]+) START attempt (?P<n>[0-9]+) model (?P<model>[a-z]+) effort (?P<effort>[a-z]+)",
    "end": "^(?P<time>[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:]{8}) STEP (?P<part>[A-Z0-9]+) END exit=(?P<exit>[0-9]+) status=(?P<status>[A-Z ]+)"
  },
  "docker": true
}
* text=auto eol=lf
# Generated by `npm run bundle` in runtime/ (ADR 0063 item 8): committed build output, regenerated by the lead.
skills/*/bundle/** linguist-generated=true
# The native terminal files (ADR 0082) are binary: never converted. Git detects the NUL bytes anyway; this makes it explicit.
skills/*/bundle/native/**/*.node -text
skills/*/bundle/native/**/*.dll -text
skills/*/bundle/native/**/*.exe -text

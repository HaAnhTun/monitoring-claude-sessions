{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monitoring-claude-sessions.local/schemas/cli-envelope.v1.schema.json",
  "$comment": "Generated by runtime/scripts/gen-schemas.mjs (npm run schemas); generated; do not edit.",
  "title": "CLI JSON envelope (mcs.cli/1)",
  "description": "The document every command prints with --json; `data` depends on the command (see docs/cli.md).",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "mcs.cli/1"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "data": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "USAGE",
                "CONFIG_INVALID",
                "CONFIG_SCHEMA_MISSING",
                "CONFIG_SCHEMA_UNSUPPORTED",
                "CONFIG_UNREADABLE",
                "REGEX_UNSUPPORTED",
                "SLUG_INVALID",
                "TASK_NOT_FOUND",
                "WORKSPACE_ESCAPE",
                "WORKSPACE_SYMLINK",
                "WORKSPACE_INVALID",
                "WORKSPACE_EXISTS_CONFIG_DIFFERS",
                "INSTANCE_NOT_INITIALIZED",
                "IDENTITY_MISMATCH",
                "INSTANCE_RUNNING",
                "INSTANCE_NOT_RUNNING",
                "START_FAILED",
                "START_TIMEOUT",
                "PORT_EXHAUSTED",
                "STOP_FAILED",
                "NOT_OUR_PROCESS",
                "DB_NEWER_THAN_RUNTIME",
                "DB_UPGRADE_REQUIRED",
                "DB_ERROR",
                "DOWNGRADE_REFUSED",
                "BACKUP_NOT_FOUND",
                "BACKUP_INVALID",
                "CONFIRMATION_REQUIRED",
                "ISOLATION_VIOLATION",
                "OUTPUT_EXISTS",
                "OUTPUT_PATH_FORBIDDEN",
                "BOOTSTRAP_FAILED",
                "NODE_TOO_OLD",
                "RUNTIME_IN_USE",
                "HOOKS_FAILED",
                "NOT_FOUND",
                "API_ERROR",
                "INTERNAL"
              ]
            },
            "message": {
              "type": "string"
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            },
            "details": {
              "anyOf": [
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "message",
            "hint",
            "details"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "command",
    "ok",
    "exitCode",
    "data",
    "error",
    "warnings"
  ],
  "additionalProperties": false
}

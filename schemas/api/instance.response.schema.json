{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monitoring-claude-sessions.local/schemas/api/instance.response.schema.json",
  "$comment": "Generated by runtime/scripts/gen-schemas.mjs (npm run schemas); generated; do not edit.",
  "title": "instance response",
  "description": "GET /api/v3/instance: Identity, configuration summary, poll intervals, features and limits of the instance. (response; generated from the route registry of @mcs/shared, docs/design/03-data-api-realtime.md section 13).",
  "type": "object",
  "properties": {
    "instanceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "slug": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtimeVersion": {
      "type": "string"
    },
    "codeStamp": {
      "type": "string"
    },
    "dbSchemaVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "headSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "staleAfterMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "heartbeatMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "windowHours": {
      "type": "number",
      "minimum": 0
    },
    "ui": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ]
        },
        "density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ]
        },
        "newestFirst": {
          "type": "boolean"
        },
        "showTools": {
          "type": "boolean"
        },
        "showThinking": {
          "type": "boolean"
        },
        "showPrompts": {
          "type": "boolean"
        }
      },
      "required": [
        "theme",
        "density",
        "newestFirst",
        "showTools",
        "showThinking",
        "showPrompts"
      ],
      "additionalProperties": false
    },
    "panels": {
      "type": "object",
      "properties": {
        "git": {
          "type": "boolean"
        },
        "machine": {
          "type": "boolean"
        },
        "attempts": {
          "type": "boolean"
        },
        "ledger": {
          "type": "boolean"
        },
        "chainLog": {
          "type": "boolean"
        },
        "logs": {
          "type": "boolean"
        }
      },
      "required": [
        "git",
        "machine",
        "attempts",
        "ledger",
        "chainLog",
        "logs"
      ],
      "additionalProperties": false
    },
    "poll": {
      "type": "object",
      "properties": {
        "healthMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sessionsMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overviewMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transcriptMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "machineMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "logsMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attemptsMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "healthMs",
        "sessionsMs",
        "overviewMs",
        "transcriptMs",
        "machineMs",
        "logsMs",
        "attemptsMs"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "transcriptSearch": {
          "type": "string",
          "enum": [
            "session",
            "instance"
          ]
        },
        "costEstimates": {
          "type": "boolean"
        },
        "usageTrend": {
          "type": "boolean"
        },
        "hooks": {
          "type": "boolean"
        }
      },
      "required": [
        "transcriptSearch",
        "costEstimates",
        "usageTrend",
        "hooks"
      ],
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "restart": {
          "type": "string"
        },
        "inspect": {
          "type": "string"
        },
        "export": {
          "type": "string"
        },
        "backup": {
          "type": "string"
        },
        "cleanupDryRun": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "restart",
        "inspect",
        "export",
        "backup",
        "cleanupDryRun"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "pageMax": {
          "type": "number",
          "const": 200
        },
        "eventsQueryWindowDays": {
          "type": "number",
          "const": 7
        },
        "searchBudgetMsMax": {
          "type": "number",
          "const": 10000
        },
        "textChars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "pageMax",
        "eventsQueryWindowDays",
        "searchBudgetMsMax",
        "textChars"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "instanceId",
    "slug",
    "title",
    "description",
    "runtimeVersion",
    "codeStamp",
    "dbSchemaVersion",
    "headSeq",
    "epoch",
    "staleAfterMs",
    "heartbeatMs",
    "windowHours",
    "ui",
    "panels",
    "poll",
    "features",
    "retention",
    "commands",
    "limits"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monitoring-claude-sessions.local/schemas/state.v1.schema.json",
  "$comment": "Generated by runtime/scripts/gen-schemas.mjs (npm run schemas); generated; do not edit.",
  "title": "Running instance (state.json)",
  "description": "Runtime-only; written by whichever engine runs. Unknown keys are allowed (see docs/configuration.md).",
  "type": "object",
  "properties": {
    "pid": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "url": {
      "type": "string",
      "pattern": "^http:\\/\\/127\\.0\\.0\\.1:\\d{1,5}$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "started": {
      "type": "number",
      "minimum": 0
    },
    "version": {
      "type": "string"
    },
    "task": {
      "type": [
        "string",
        "null"
      ]
    },
    "config": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "engine": {
      "type": "string",
      "const": "node"
    },
    "instanceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runtimeVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "codeStamp": {
      "type": "string",
      "pattern": "^[0-9a-f]{10}$"
    },
    "startedAt": {
      "type": "string"
    },
    "nodeVersion": {
      "type": "string"
    },
    "control": {
      "type": "string"
    }
  },
  "required": [
    "pid",
    "url",
    "port",
    "started",
    "version",
    "task",
    "config"
  ],
  "additionalProperties": false
}

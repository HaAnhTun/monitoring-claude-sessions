{
  "_comment": "Shared defaults for every monitored task. A task's config.json (or a legacy --config file) overrides single keys; dict keys (panels, ui, poll, limits) merge key by key, lists and scalars replace. Keys starting with _ are ignored.",
  "schema_version": 1,
  "title": "Claude sessions monitor",
  "port": 8765,
  "repo": ".",
  "transcripts_dir": "auto",
  "window_hours": 8,
  "active_seconds": 120,
  "pending_tool_grace_seconds": 900,
  "include_unmatched": false,
  "session_rules": [],
  "session_ids": [],
  "panels": { "machine": true, "git": true, "logs": true, "ledger": false, "chain_log": false, "attempts": false },
  "live_log_globs": [],
  "chain_log": null,
  "ledger": null,
  "stop_file": null,
  "attempts": null,
  "watched_processes": ["claude.exe", "java.exe", "node.exe", "python.exe", "docker.exe", "com.docker.backend.exe", "vmmemWSL", "chrome.exe", "Code.exe"],
  "docker": true,
  "ui": { "theme": "auto", "density": "comfortable", "newest_first": true, "show_tools": true, "show_thinking": false, "show_prompts": false },
  "poll": { "events_ms": 1500, "sessions_ms": 6000, "machine_ms": 2000, "logs_ms": 3000, "overview_ms": 5000, "attempts_ms": 6000, "stale_after_ms": 15000 },
  "limits": { "event_window_mb": 8, "max_events": 20000, "text_chars": 6000, "usage_scan_budget_ms": 1500, "usage_max_mb": 512 }
}
